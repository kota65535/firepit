{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting"
  ],
  // release.yml is generated by `dist init`. Any Action bump Renovate makes
  // there would be reverted on the next generation, and `dist plan` fails the
  // release with an "out of date" error. Bump `cargo-dist-version` instead.
  "ignorePaths": [
    ".github/workflows/release.yml"
  ],
  // Track the dist version pinned in dist-workspace.toml, which no built-in
  // manager understands.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^dist-workspace\\.toml$/"],
      "matchStrings": ["cargo-dist-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "axodotdev/cargo-dist",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    // Auto-merge patch updates
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    // A dist bump is incomplete until release.yml is regenerated, so it always
    // needs a human. Keep this after the patch rule so it wins.
    {
      "matchDepNames": ["axodotdev/cargo-dist"],
      "automerge": false,
      "addLabels": ["needs-dist-generate"]
    }
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
  }
}
